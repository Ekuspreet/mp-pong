{
  "name": "@polygon-pong/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:shared": "npm --prefix ../shared run build",
    "predev": "npm run build:shared",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "prebuild": "npm run build:shared",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "pretypecheck": "npm run build:shared",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build:shared",
    "test": "vitest run",
    "lint": "oxlint src"
  },
  "dependencies": {
    "@polygon-pong/shared": "file:../shared",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.2.0",
    "cookie": "^1.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "ws": "^8.18.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie": "^1.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "oxlint": "^1.79.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
